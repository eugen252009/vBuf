  "external_ggml_existing_diff": "diff --git a/src/ggml-cuda/ggml-cuda.cu b/src/ggml-cuda/ggml-cuda.cu\nindex 598f3228..725cd0e3 100644\n--- a/src/ggml-cuda/ggml-cuda.cu\n+++ b/src/ggml-cuda/ggml-cuda.cu\n@@ -1812,6 +1812,24 @@ static bool ggml_cuda_should_fuse_mul_mat_vec_q(const ggml_tensor * tensor) {\n static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {\n     GGML_TENSOR_BINARY_OP_LOCALS\n \n+    const bool trace_qwen_score = std::getenv(\"VBUF_QWEN_TRACE_CUDA_DISPATCH\") != nullptr &&\n+        src0->type == GGML_TYPE_F16 && src0->ne[0] == 128 && src0->ne[2] == 8 &&\n+        src1->type == GGML_TYPE_F32 && src1->ne[0] == 128 &&\n+        (src1->ne[1] == 16 || src1->ne[1] == 32) && src1->ne[2] == 40 &&\n+        dst->ne[0] == 40 && dst->ne[2] == 40;\n+    auto trace_qwen_route = [&](const char * route) {\n+        if (trace_qwen_score) {\n+            std::fprintf(stderr, \"QWEN_CUDA_MATMUL_DISPATCH name=%s route=%s cc=%d \"\n+                \"src0=%s[%lld,%lld,%lld] src1=%s[%lld,%lld,%lld] dst=%s[%lld,%lld,%lld]\\n\",\n+                ggml_get_name(dst), route, ggml_cuda_info().devices[ctx.device].cc,\n+                ggml_type_name(src0->type), static_cast<long long>(src0->ne[0]),\n+                static_cast<long long>(src0->ne[1]), static_cast<long long>(src0->ne[2]),\n+                ggml_type_name(src1->type), static_cast<long long>(src1->ne[0]),\n+                static_cast<long long>(src1->ne[1]), static_cast<long long>(src1->ne[2]),\n+                ggml_type_name(dst->type), static_cast<long long>(dst->ne[0]),\n+                static_cast<long long>(dst->ne[1]), static_cast<long long>(dst->ne[2]));\n+        }\n+    };\n     const int32_t hint = ggml_get_op_params_i32(dst, 1);\n     if (hint == GGML_HINT_SRC0_IS_HADAMARD && ggml_cuda_op_fwht(ctx, src1, dst)) {\n         return;\n@@ -1823,6 +1841,7 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor\n     const bool bad_padding_clear = ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE\n         && ggml_nbytes(src0) != ggml_backend_buffer_get_alloc_size(src0->buffer, src0) && src0->view_src;\n     if (bad_padding_clear || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {\n+        trace_qwen_route(\"CUBLAS_PRECHECK_FALLBACK\");\n         ggml_cuda_mul_mat_cublas(ctx, src0, src1, dst);\n         return;\n     }\n@@ -1831,6 +1850,7 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor\n     const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;\n \n     if (ggml_cuda_should_use_mmvf(src0->type, cc, src0->ne, src0->nb, ne11)) {\n+        trace_qwen_route(\"MMVF\");\n         // The custom F16 vector kernel can be used over batched cuBLAS GEMM.\n         // But this is only faster for GPUs without tensor cores or with a thin src0 matrix (particularly KQV in attention)\n         ggml_cuda_mul_mat_vec_f(ctx, src0, src1, nullptr, dst);\n@@ -1851,17 +1871,21 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor\n         return;\n     }\n     if (ggml_cuda_should_use_mmf(src0->type, cc, warp_size, src0->ne, src0->nb, ne11, /*mul_mat_id =*/ false)) {\n+        trace_qwen_route(\"MMF\");\n         ggml_cuda_mul_mat_f(ctx, src0, src1, nullptr, dst);\n         return;\n     }\n     if (ggml_cuda_should_use_mmvq(src0->type, cc, ne11)) {\n+        trace_qwen_route(\"MMVQ\");\n         ggml_cuda_mul_mat_vec_q(ctx, src0, src1, nullptr, dst);\n         return;\n     }\n     if (ggml_cuda_should_use_mmq(src0->type, cc, ne11, /*n_experts =*/ 0)) {\n+        trace_qwen_route(\"MMQ\");\n         ggml_cuda_mul_mat_q(ctx, src0, src1, nullptr, dst);\n         return;\n     }\n+    trace_qwen_route(\"CUBLAS_FINAL\");\n     ggml_cuda_mul_mat_cublas(ctx, src0, src1, dst);\n }\n \n",
