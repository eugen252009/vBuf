+        : metadata(nullptr), source(std::move(source)), set_tensor_data(set_tensor_data), set_tensor_data_ud(set_tensor_data_ud) {
+    if (!this->source) throw std::runtime_error("semantic model source is null");
+    if (params.kv_overrides != nullptr) {
+        for (const struct llama_model_kv_override * p = params.kv_overrides; p->key[0] != 0; ++p) {
