+#pragma once
+
+#include "llama.h"
+#include "ggml.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+// Source-neutral semantic input to llama model construction.  A source owns
+// the backing storage for the lifetime of the model; the loader retains the
+// shared ownership handle.
+struct llama_model_source {
+    virtual ~llama_model_source() = default;
+
+    virtual int metadata_count() const = 0;
+    virtual bool get_string(const std::string & key, std::string & value) const = 0;
+    virtual bool get_u32(const std::string & key, uint32_t & value) const = 0;
+    virtual bool get_i32(const std::string & key, int32_t & value) const = 0;
+    virtual bool get_u64(const std::string & key, uint64_t & value) const = 0;
+    virtual bool get_f32(const std::string & key, float & value) const = 0;
+    virtual bool get_bool(const std::string & key, bool & value) const = 0;
+    virtual bool get_i32_array(const std::string & key, std::vector<int32_t> & value) const = 0;
+
+    virtual uint64_t tensor_count() const = 0;
+    virtual bool tensor(uint64_t index, std::string & name, ggml_type & type,
+                       std::vector<int64_t> & dimensions, const uint8_t * & payload,
+                       uint64_t & payload_bytes) const = 0;
+
+    virtual uint64_t token_count() const = 0;
+    virtual bool token(uint64_t index, std::string & text, float & score, int32_t & type) const = 0;
+    virtual uint64_t merge_count() const = 0;
+    virtual bool merge(uint64_t index, uint64_t & left, uint64_t & right) const = 0;
+};
+
+// C++ source seam used by integrations.  GGUF continues through the native
+// file loader; non-GGUF sources enter the same llama_model_base builder here.
+LLAMA_API struct llama_model * llama_model_init_from_source(
+        std::shared_ptr<llama_model_source> source,
+        llama_model_set_tensor_data_t set_tensor_data,
+        void * set_tensor_data_ud,
+        struct llama_model_params params);
