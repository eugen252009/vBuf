+    get_key(llm_kv(LLM_KV_GENERAL_ARCHITECTURE), arch_name, true);
+    llm_kv = LLM_KV(llm_arch_from_string(arch_name));
+
+    const uint64_t count = this->source->tensor_count();
+    ggml_init_params init_params = {
+        /*.mem_size   =*/ ggml_tensor_overhead() * (count + 1),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context * ctx = ggml_init(init_params);
+    if (!ctx) throw std::runtime_error("failed to create semantic source tensor context");
+    contexts.emplace_back(ctx);
+    for (uint64_t i = 0; i < count; ++i) {
+        std::string name;
+        ggml_type type;
+        std::vector<int64_t> dimensions;
+        const uint8_t * payload = nullptr;
+        uint64_t payload_bytes = 0;
+        if (!this->source->tensor(i, name, type, dimensions, payload, payload_bytes) || name.empty() || dimensions.empty() || dimensions.size() > GGML_MAX_DIMS || payload == nullptr) {
+            throw std::runtime_error("invalid semantic source tensor descriptor");
+        }
+        ggml_tensor * tensor = ggml_new_tensor(ctx, type, dimensions.size(), dimensions.data());
+        if (!tensor) throw std::runtime_error("failed to create semantic source tensor metadata");
+        ggml_set_name(tensor, name.c_str());
+        if (!weights_map.emplace(name, llama_tensor_weight(0, tensor)).second) {
+            throw std::runtime_error(format("invalid model: tensor '%s' is duplicated", name.c_str()));
+        }
+        n_elements += ggml_nelements(tensor);
+        n_bytes += payload_bytes;
+    }
+    n_tensors = weights_map.size();
+    n_kv = this->source->metadata_count();
+    fver = GGUF_FILE_VERSION_V3;
+    check_tensors = params.check_tensors;
+    no_alloc = params.no_alloc;
+    load_mtp = params.load_mtp;
+
+    std::map<ggml_type, uint32_t> types;
+    for (const auto & item : weights_map) ++types[item.second.tensor->type];
+    ggml_type dominant = GGML_TYPE_F32;
+    uint32_t dominant_count = 0;
+    for (const auto & item : types) if (item.second > dominant_count) { dominant = item.first; dominant_count = item.second; }
+    switch (dominant) {
+        case GGML_TYPE_BF16: ftype = LLAMA_FTYPE_MOSTLY_BF16; break;
+        case GGML_TYPE_Q8_0: ftype = LLAMA_FTYPE_MOSTLY_Q8_0; break;
+        default: ftype = LLAMA_FTYPE_ALL_F32; break;
+    }
+    ftype = (llama_ftype) (ftype | LLAMA_FTYPE_GUESSED);
