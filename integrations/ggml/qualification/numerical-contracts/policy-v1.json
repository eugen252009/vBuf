  "tolerance_profiles": {
    "qwen3.synthetic-av-absolute.v1": {
      "version": 1,
      "criteria": [
        {
          "metric": "max_absolute_error",
          "comparison": "less_than",
          "value": 0.001,
          "unit": "absolute",
          "required": true
        }
      ],
      "provenance": "Existing synthetic AV direct test shared ceiling; canonical packed AV historically uses strict max_abs < 1e-3. Native AV also retains its stricter 3e-6 assertion."
    },
    "qwen3.native-av-synthetic-strict.v1": {
      "version": 1,
      "criteria": [
        {
          "metric": "max_absolute_error",
          "comparison": "less_than",
          "value": 0.000003,
          "unit": "absolute",
          "required": true
        }
      ],
      "provenance": "Retains the existing strict native AV assertion (< 3e-6 absolute error) on the deterministic FP64-oracle direct-test fixtures only."
    },
    "qwen3.final-output.compatibility.v1": {
      "version": 1,
      "criteria": [
        {
          "metric": "relative_rms_error",
          "comparison": "less_equal",
          "value": 0.02,
          "unit": "fraction",
          "required": true
        },
        {
          "metric": "cosine_similarity",
          "comparison": "greater_equal",
          "value": 0.9998,
          "unit": "fraction",
          "required": true
        }
      ],
      "provenance": "Preserves the existing small-context Qwen canonical/native and cross-device gate: relative RMS <= 0.02 and cosine >= 0.9998. Not a universal tensor tolerance."
    }
  },
