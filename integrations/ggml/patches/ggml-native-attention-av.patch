+// ggml_attention_av
+
+struct ggml_tensor * ggml_attention_av(
+        struct ggml_context * ctx,
+        struct ggml_tensor * value,
+        struct ggml_tensor * weights,
+        struct ggml_tensor * positions) {
+    GGML_ASSERT(value->type == GGML_TYPE_F16 || value->type == GGML_TYPE_F32);
+    GGML_ASSERT(weights->type == GGML_TYPE_F32);
+    GGML_ASSERT(positions->type == GGML_TYPE_I32);
+    GGML_ASSERT(value->ne[0] > 0 && value->ne[1] > 0 && value->ne[2] == 1 && value->ne[3] == 1);
+    GGML_ASSERT(weights->ne[0] > 0 && weights->ne[1] > 0 && weights->ne[2] > 0 && weights->ne[3] == 1);
+    GGML_ASSERT(positions->ne[0] == weights->ne[1] && positions->ne[1] == 1 &&
+        positions->ne[2] == 1 && positions->ne[3] == 1);
+    GGML_ASSERT(value->ne[1] % weights->ne[0] == 0);
+    const int64_t n_kv_heads = value->ne[1] / weights->ne[0];
+    GGML_ASSERT(weights->ne[2] % n_kv_heads == 0);
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32,
+        value->ne[0], weights->ne[1], weights->ne[2]);
+    result->op = GGML_OP_ATTENTION_AV;
+    result->src[0] = value;
+    result->src[1] = weights;
+    result->src[2] = positions;
+    return result;
+}
