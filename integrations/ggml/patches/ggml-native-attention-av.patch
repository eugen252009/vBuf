+void ggml_compute_forward_attention_av(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * value = dst->src[0];
+    const ggml_tensor * weights = dst->src[1];
+    const ggml_tensor * positions = dst->src[2];
+    GGML_ASSERT(value->type == GGML_TYPE_F16 || value->type == GGML_TYPE_F32);
+    GGML_ASSERT(weights->type == GGML_TYPE_F32 && positions->type == GGML_TYPE_I32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    const int64_t n_dim = value->ne[0];
+    const int64_t n_positions = weights->ne[0];
+    const int64_t n_queries = weights->ne[1];
+    const int64_t n_query_heads = weights->ne[2];
+    GGML_ASSERT(value->ne[1] % n_positions == 0);
+    const int64_t n_kv_heads = value->ne[1] / n_positions;
+    GGML_ASSERT(n_query_heads % n_kv_heads == 0);
+    GGML_ASSERT(dst->ne[0] == n_dim && dst->ne[1] == n_queries && dst->ne[2] == n_query_heads);
+
+    GGML_TENSOR_LOCALS(size_t, nbv, value, nb);
+    GGML_TENSOR_LOCALS(size_t, nbw, weights, nb);
+    GGML_TENSOR_LOCALS(size_t, nbp, positions, nb);
+    GGML_TENSOR_LOCALS(size_t, nbd, dst, nb);
+
+    const int64_t n_outputs = n_dim * n_queries * n_query_heads;
+    const int64_t chunk = (n_outputs + params->nth - 1) / params->nth;
+    const int64_t begin = chunk * params->ith;
+    const int64_t end = MIN(begin + chunk, n_outputs);
+    for (int64_t linear = begin; linear < end; ++linear) {
+        const int64_t d = linear % n_dim;
+        const int64_t qh = linear / n_dim;
+        const int64_t q = qh % n_queries;
+        const int64_t h = qh / n_queries;
+        const int64_t kv_h = h / (n_query_heads / n_kv_heads);
+        const int32_t last_position = *(const int32_t *) ((const char *) positions->data + q * nbp0);
+        GGML_ASSERT(last_position >= 0 && last_position < n_positions);
+        float sum = 0.0f;
+        for (int64_t p = 0; p <= last_position; ++p) {
+            const float weight = *(const float *) ((const char *) weights->data +
+                p * nbw0 + q * nbw1 + h * nbw2);
+            float v;
+            const char * value_ptr = (const char *) value->data +
+                d * nbv0 + (p * n_kv_heads + kv_h) * nbv1;
+            if (value->type == GGML_TYPE_F16) {
+                v = GGML_FP16_TO_FP32(*(const ggml_fp16_t *) value_ptr);
+            } else {
+                v = *(const float *) value_ptr;
+            }
+            sum += weight * v;
+        }
+        *(float *) ((char *) dst->data + d * nbd0 + q * nbd1 + h * nbd2) = sum;
+    }
+}
