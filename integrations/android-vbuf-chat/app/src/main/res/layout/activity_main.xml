<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F4F1EA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="vBuf / Android ARM64"
        android:textColor="#173F3A"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Opening local Qwen3-0.6B..."
        android:textColor="#53615E"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:background="#FFFDF8"
        android:padding="14dp">
        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#17211F"
            android:textSize="17sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <EditText
        android:id="@+id/prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Ask the local model"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3" />

    <Button
        android:id="@+id/send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Generate 16 tokens" />
</LinearLayout>
